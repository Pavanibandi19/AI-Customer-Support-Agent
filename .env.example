# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Execution Settings
# DEMO_MODE: auto (uses Ollama if reachable, falls back to deterministic rule engine), true (always demo), false (strict Ollama)
DEMO_MODE=auto
MAX_AGENT_STEPS=5

# Database Settings
DATABASE_PATH=data/customer_support.db

# Logging
LOG_LEVEL=INFO
